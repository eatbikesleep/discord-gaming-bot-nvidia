# Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
# Optional: your server ID = instant slash command registration
GUILD_ID=

# One free NVIDIA key covers LLM + speech-to-text + text-to-speech
# Get it at https://build.nvidia.com (Get API Key) -> starts with nvapi-
NVIDIA_API_KEY=nvapi-your-key

# LLM (OpenAI-compatible endpoint). Any chat model from build.nvidia.com; a small non-reasoning model is fastest.
NVIDIA_LLM_MODEL=meta/llama-3.1-8b-instruct

# Speech: hosted Riva gRPC functions. Copy the Function ID from each model's "API" tab on build.nvidia.com
# (parakeet-ctc-1_1b-asr and magpie-tts-multilingual). IDs can change, so re-check if you get NOT_FOUND errors.
NVIDIA_ASR_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
LANGUAGE_CODE=en-US
TTS_SAMPLE_RATE=22050
